{
    "name": "Clean Light",
    "version": "1.0",
    "author": "NewGearDay",
    "description": "Clean, minimal light theme with modern sans-serif typography",
    "thumbnail": "preview.png",
    "colors": {
        "primary": "#2563EB",
        "secondary": "#DC2626",
        "nav_bg": "#FFFFFF",
        "nav_text": "#374151",
        "footer_bg": "#F9FAFB",
        "footer_text": "#6B7280",
        "announcement_bg": "#2563EB",
        "announcement_text": "#FFFFFF"
    },
    "fonts": {
        "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    },
    "settings": {
        "card_shadow": {
            "type": "select",
            "label": "Card Shadow",
            "options": ["none", "subtle", "medium"],
            "default": "subtle"
        },
        "border_radius": {
            "type": "select",
            "label": "Border Radius",
            "options": ["none", "small", "medium", "large"],
            "default": "medium"
        },
        "header_style": {
            "type": "select",
            "label": "Header Style",
            "options": ["simple", "centered", "full-width"],
            "default": "simple"
        }
    }
}
