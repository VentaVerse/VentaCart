{
    "name": "Clean Light",
    "version": "1.0",
    "author": "Venta",
    "description": "Clean, minimal light theme with modern sans-serif typography",
    "thumbnail": "preview.png",
    "colors": {
        "primary": "#2563EB",
        "secondary": "#DC2626",
        "bg": "#FFFFFF",
        "text": "#374151",
        "text_heading": "#111827",
        "text_muted": "#9CA3AF",
        "card_bg": "#F9FAFB",
        "border": "#E5E7EB",
        "btn_text": "#FFFFFF",
        "nav_bg": "#FFFFFF",
        "nav_text": "#374151",
        "footer_bg": "#F9FAFB",
        "footer_text": "#6B7280",
        "footer_heading": "#111827",
        "price": "#111827",
        "input_bg": "#FFFFFF",
        "input_border": "#D1D5DB",
        "breadcrumb_bg": "#F9FAFB",
        "search_bg": "#F3F4F6",
        "badge_new": "#16a34a",
        "badge_hot": "#f59e0b",
        "star_rating": "#f59e0b",
        "sale_price": "#DC2626",
        "announcement_bg": "#2563EB",
        "announcement_text": "#FFFFFF",
        "logo_text": "#111827",
        "badge_free_shipping": "#16a34a",
        "card_hover": "#2563EB",
        "dropdown_bg": "#FFFFFF",
        "sidebar_bg": "#F9FAFB",
        "checkout_option_bg": "#F9FAFB",
        "review_bg": "#F9FAFB",
        "success": "#16a34a",
        "error": "#dc2626"
    },
    "fonts": {
        "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
    },
    "settings": {
        "card_shadow": {
            "type": "select",
            "label": "Card Shadow",
            "options": ["none", "subtle", "medium"],
            "default": "subtle"
        },
        "border_radius": {
            "type": "select",
            "label": "Border Radius",
            "options": ["none", "small", "medium", "large"],
            "default": "medium"
        },
        "header_style": {
            "type": "select",
            "label": "Header Style",
            "options": ["simple", "centered", "full-width"],
            "default": "simple"
        }
    }
}
