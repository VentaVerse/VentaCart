{
    "name": "Clean Light",
    "version": "1.0",
    "author": "NewGearDay",
    "description": "Clean, minimal light theme with modern sans-serif typography",
    "thumbnail": "preview.png",
    "settings": {
        "card_shadow": {
            "type": "select",
            "label": "Card Shadow",
            "options": ["none", "subtle", "medium"],
            "default": "subtle"
        },
        "border_radius": {
            "type": "select",
            "label": "Border Radius",
            "options": ["none", "small", "medium", "large"],
            "default": "medium"
        },
        "header_style": {
            "type": "select",
            "label": "Header Style",
            "options": ["simple", "centered", "full-width"],
            "default": "simple"
        }
    }
}
