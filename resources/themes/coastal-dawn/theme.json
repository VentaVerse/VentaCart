{
    "name": "Coastal Dawn",
    "version": "1.0",
    "author": "Venta",
    "description": "Light sand theme with navy accents and warm vintage tones",
    "thumbnail": "preview.png",
    "colors": {
        "primary": "#1A3263",
        "secondary": "#FAB95B",
        "nav_bg": "#F5F0E8",
        "nav_text": "#1A3263",
        "footer_bg": "#E8E2DB",
        "footer_text": "#547792",
        "announcement_bg": "#1A3263",
        "announcement_text": "#FAB95B"
    },
    "fonts": {
        "url": "https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Source+Sans+3:wght@300;400;600;700&display=swap"
    },
    "settings": {
        "card_shadow": {
            "type": "select",
            "label": "Card Shadow",
            "options": ["none", "subtle", "medium"],
            "default": "subtle"
        },
        "border_radius": {
            "type": "select",
            "label": "Border Radius",
            "options": ["none", "small", "medium", "large"],
            "default": "medium"
        },
        "header_style": {
            "type": "select",
            "label": "Header Style",
            "options": ["simple", "centered", "full-width"],
            "default": "simple"
        }
    }
}
