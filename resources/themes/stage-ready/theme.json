{
    "name": "Stage Ready",
    "version": "1.0",
    "author": "NewGearDay",
    "description": "Dark pedalboard theme with amber glow effects, noise texture, and LED indicators",
    "thumbnail": "preview.png",
    "colors": {
        "primary": "#F5A623",
        "secondary": "#E2293D",
        "bg": "#0D0D0D",
        "text": "#C8C8C8",
        "text_heading": "#E8E8E8",
        "text_muted": "#999999",
        "card_bg": "#1A1A1A",
        "border": "#2A2A2A",
        "btn_text": "#0D0D0D",
        "nav_bg": "#111111",
        "nav_text": "#E8E8E8",
        "footer_bg": "#080808",
        "footer_text": "#B0B0B0",
        "footer_heading": "#E8E8E8",
        "price": "#E8E8E8",
        "announcement_bg": "#F5A623",
        "announcement_text": "#0D0D0D"
    },
    "fonts": {
        "url": "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Mono:wght@400;700&display=swap"
    },
    "settings": {
        "glow_intensity": {
            "type": "select",
            "label": "Glow Intensity",
            "options": ["low", "medium", "high"],
            "default": "medium"
        },
        "noise_texture": {
            "type": "toggle",
            "label": "Noise Texture Overlay",
            "default": true
        },
        "led_indicators": {
            "type": "toggle",
            "label": "LED Indicator Dots",
            "default": true
        },
        "scroll_reveal": {
            "type": "toggle",
            "label": "Scroll Reveal Animations",
            "default": true
        }
    }
}
