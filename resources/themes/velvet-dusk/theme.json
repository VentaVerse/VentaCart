{
    "name": "Velvet Dusk",
    "version": "1.0",
    "author": "Venta",
    "description": "Warm dark theme with peach and coffee tones, vintage elegance",
    "thumbnail": "preview.png",
    "colors": {
        "primary": "#F7CCAC",
        "secondary": "#C69B7B",
        "nav_bg": "#2E2B33",
        "nav_text": "#F7CCAC",
        "footer_bg": "#2A2730",
        "footer_text": "#826F66",
        "announcement_bg": "#F7CCAC",
        "announcement_text": "#3A3845"
    },
    "fonts": {
        "url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Nunito+Sans:wght@300;400;600&display=swap"
    },
    "settings": {
        "glow_intensity": {
            "type": "select",
            "label": "Glow Intensity",
            "options": ["low", "medium", "high"],
            "default": "low"
        },
        "scroll_reveal": {
            "type": "toggle",
            "label": "Scroll Reveal Animations",
            "default": true
        }
    }
}
