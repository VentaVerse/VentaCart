{
    "name": "Venta",
    "version": "2.0",
    "author": "Venta",
    "description": "VentaCart's default theme. The look is fixed; merchants arrange the storefront in Layout.",
    "thumbnail": "preview.png",
    "regions": {
        "header_top": {
            "label": "Above the header"
        },
        "content_top": {
            "label": "Above the content"
        },
        "column_left": {
            "label": "Left column",
            "column": "left"
        },
        "column_right": {
            "label": "Right column",
            "column": "right"
        },
        "content_bottom": {
            "label": "Below the content"
        },
        "footer_top": {
            "label": "Above the footer"
        }
    },
    "page_settings": {
        "show_breadcrumbs": {
            "label": "Breadcrumbs",
            "type": "toggle",
            "part": "body",
            "default": true,
            "pages": [
                "category",
                "product",
                "blog",
                "page",
                "brand",
                "account",
                "cart",
                "checkout",
                "search"
            ]
        },
        "show_page_title": {
            "label": "Page title",
            "type": "toggle",
            "part": "body",
            "default": true,
            "pages": [
                "category",
                "product",
                "blog",
                "page",
                "brand",
                "account",
                "cart",
                "checkout",
                "search"
            ]
        },
        "show_reviews": {
            "label": "Reviews",
            "type": "toggle",
            "part": "body",
            "default": true,
            "pages": [
                "product"
            ]
        },
        "show_footer": {
            "label": "Footer",
            "type": "toggle",
            "part": "footer",
            "default": true
        }
    }
}
