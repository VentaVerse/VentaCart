{
    "name": "Venta",
    "version": "2.0",
    "author": "Venta",
    "description": "The Venta master theme. Every look is a preset: colors, fonts, and options layered over this base.",
    "thumbnail": "preview.png",
    "colors": {
        "primary": "#2563EB",
        "secondary": "#DC2626",
        "bg": "#FFFFFF",
        "text": "#374151",
        "text_heading": "#111827",
        "text_muted": "#9CA3AF",
        "card_bg": "#F9FAFB",
        "border": "#E5E7EB",
        "content_text": "#4B5563",
        "btn_text": "#FFFFFF",
        "nav_bg": "#FFFFFF",
        "nav_text": "#374151",
        "footer_bg": "#F9FAFB",
        "footer_text": "#6B7280",
        "footer_heading": "#111827",
        "price": "#111827",
        "input_bg": "#FFFFFF",
        "input_border": "#D1D5DB",
        "breadcrumb_bg": "#F9FAFB",
        "payment_badge_bg": "#F3F4F6",
        "search_bg": "#F3F4F6",
        "badge_new": "#16a34a",
        "badge_hot": "#f59e0b",
        "star_rating": "#f59e0b",
        "sale_price": "#DC2626",
        "announcement_bg": "#2563EB",
        "announcement_text": "#FFFFFF",
        "logo_text": "#111827",
        "badge_free_shipping": "#16a34a",
        "card_hover": "#2563EB",
        "dropdown_bg": "#FFFFFF",
        "sidebar_bg": "#F9FAFB",
        "checkout_option_bg": "#F9FAFB",
        "review_bg": "#F9FAFB",
        "success": "#16a34a",
        "error": "#dc2626",
        "danger_bg": "#FEF2F2",
        "danger_border": "#FECACA",
        "danger_text": "#B91C1C",
        "danger_accent": "#EF4444",
        "success_bg": "#F0FDF4",
        "success_text": "#15803D",
        "success_accent": "#22C55E",
        "brand_tile_bg": "transparent"
    },
    "fonts": {
        "heading": "Figtree",
        "body": "Figtree",
        "heading_stack": "sans-serif",
        "body_stack": "sans-serif"
    },
    "settings": {
        "header_layout": {
            "type": "layout",
            "label": "Header Layout",
            "options": [
                "marketplace",
                "centered",
                "inline",
                "search-under"
            ],
            "default": "marketplace"
        },
        "category_layout": {
            "type": "layout",
            "label": "Category Layout",
            "options": [
                "sidebar-left",
                "sidebar-right",
                "offcanvas"
            ],
            "default": "sidebar-left"
        },
        "product_gallery_side": {
            "type": "layout",
            "label": "Product Gallery Side",
            "options": [
                "left",
                "right"
            ],
            "default": "left"
        },
        "product_info_style": {
            "type": "layout",
            "label": "Product Info Style",
            "options": [
                "tabs",
                "stacked"
            ],
            "default": "tabs"
        },
        "footer_layout": {
            "type": "layout",
            "label": "Footer Layout",
            "options": [
                "columns",
                "centered",
                "split"
            ],
            "default": "columns"
        },
        "glow_intensity": {
            "type": "select",
            "label": "Glow Intensity",
            "options": [
                "none",
                "low",
                "medium",
                "high"
            ],
            "default": "none"
        },
        "noise_texture": {
            "type": "toggle",
            "label": "Noise Texture",
            "default": false
        },
        "led_indicators": {
            "type": "toggle",
            "label": "LED Indicator Dots",
            "default": true
        },
        "scroll_reveal": {
            "type": "toggle",
            "label": "Scroll Reveal Animations",
            "default": true
        }
    },
    "vars": {
        "track_nav": "0",
        "track_heading": "0",
        "brand_tile_dim": "0.6"
    }
}
