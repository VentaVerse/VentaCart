{
  "type": "category-tiles",
  "label": "Category tiles",
  "group": "template",
  "picker_group": "categories",
  "picker_order": 30,
  "templates": [
    "*"
  ],
  "limit": null,
  "main": false,
  "span": {
    "min": 6
  },
  "class": "s-categories",
  "variants": [
    {
      "value": "image-cards",
      "label": "Photo cards"
    },
    {
      "value": "circles",
      "label": "Round photos"
    },
    {
      "value": "text-over-image",
      "label": "Name on the photo"
    },
    {
      "value": "chips",
      "label": "Compact list"
    }
  ],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "default": "image-cards",
      "options": [
        {
          "value": "image-cards",
          "label": "Photo cards"
        },
        {
          "value": "circles",
          "label": "Round photos"
        },
        {
          "value": "text-over-image",
          "label": "Name on the photo"
        },
        {
          "value": "chips",
          "label": "Compact list"
        }
      ],
      "control": "cards"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "key": "subheading",
      "type": "textarea",
      "label": "Text under the heading",
      "default": ""
    },
    {
      "key": "link_label",
      "type": "text",
      "label": "Link beside the heading",
      "default": "All categories"
    },
    {
      "key": "link",
      "type": "url",
      "label": "Link goes to",
      "default": {
        "type": "search"
      }
    },
    {
      "key": "cols",
      "type": "range",
      "label": "Tiles per row",
      "default": 4,
      "min": 2,
      "max": 6,
      "step": 1
    },
    {
      "key": "ratio",
      "type": "select",
      "label": "Photo shape",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "tall",
          "label": "Tall 3:4"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "control": "segmented"
    },
    {
      "key": "show_note",
      "type": "toggle",
      "label": "Show the short note under each name",
      "default": true
    },
    {
      "key": "mobile_layout",
      "type": "select",
      "label": "On phones",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Two per row"
        },
        {
          "value": "scroll",
          "label": "Swipe row"
        }
      ],
      "control": "segmented"
    },
    {
      "key": "head_align",
      "type": "select",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "control": "segmented",
      "advanced": true
    },
    {
      "key": "scheme",
      "type": "color-scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "key": "bg_image",
      "type": "image",
      "label": "Background photo",
      "default": "",
      "advanced": true
    },
    {
      "key": "bg_overlay",
      "type": "range",
      "label": "Darken background photo",
      "default": 40,
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "advanced": true
    },
    {
      "key": "texture",
      "type": "select",
      "label": "Background texture",
      "default": "none",
      "advanced": true,
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "grid",
          "label": "Grid lines"
        },
        {
          "value": "lines",
          "label": "Diagonal lines"
        },
        {
          "value": "grain",
          "label": "Fine grain"
        }
      ]
    },
    {
      "key": "pad",
      "type": "select",
      "label": "Space above and below",
      "default": "md",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "control": "segmented"
    }
  ],
