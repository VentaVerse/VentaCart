{
  "type": "featured-products",
  "label": "Featured products",
  "group": "template",
  "picker_group": "products",
  "picker_order": 20,
  "templates": [
    "*"
  ],
  "limit": null,
  "main": false,
  "span": {
    "min": 6
  },
  "class": "s-products",
  "variants": [
    {
      "value": "grid",
      "label": "Grid"
    },
    {
      "value": "carousel",
      "label": "Swipe row"
    },
    {
      "value": "list",
      "label": "Compact list"
    }
  ],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Swipe row"
        },
        {
          "value": "list",
          "label": "Compact list"
        }
      ],
      "control": "cards"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Best sellers"
    },
    {
      "key": "subheading",
      "type": "textarea",
      "label": "Text under the heading",
      "default": ""
    },
    {
      "key": "link_label",
      "type": "text",
      "label": "Link beside the heading",
      "default": "View all"
    },
    {
      "key": "link",
      "type": "url",
      "label": "Link goes to",
      "default": {
        "type": "search"
      }
    },
    {
      "key": "source",
      "type": "select",
      "label": "Products to show",
      "default": "best-sellers",
      "options": [
        {
          "value": "newest",
          "label": "Newest"
        },
        {
          "value": "best-sellers",
          "label": "Best sellers"
        },
        {
          "value": "on-sale",
          "label": "On sale"
        },
        {
          "value": "most-viewed",
          "label": "Most viewed"
        },
        {
          "value": "category",
          "label": "From a category"
        },
        {
          "value": "brand",
          "label": "From a brand"
        },
        {
          "value": "hand-picked",
          "label": "Picked by hand"
        }
      ],
      "info": "Products hidden from a shopper's customer group never show."
    },
    {
      "key": "category",
      "type": "category-picker",
      "label": "Category",
      "default": null,
      "visible_if": {
        "source": "category"
      }
    },
    {
      "key": "brand",
      "type": "brand-picker",
      "label": "Brand",
      "default": null,
      "visible_if": {
        "source": "brand"
      }
    },
    {
      "key": "products",
      "type": "product-picker",
      "label": "Products",
      "default": [],
      "multiple": true,
      "max": 16,
      "visible_if": {
        "source": "hand-picked"
      }
    },
    {
      "key": "count",
      "type": "range",
      "label": "Most products shown",
      "default": 8,
      "min": 2,
      "max": 16,
      "step": 1
    },
    {
      "key": "cols",
      "type": "range",
      "label": "Products per row",
      "default": 4,
      "min": 2,
      "max": 5,
      "step": 1
    },
    {
      "key": "rows",
      "type": "range",
      "label": "Most rows",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "visible_if": {
        "variant": "grid"
      }
    },
    {
      "key": "autoplay",
      "type": "toggle",
      "label": "Autoplay",
      "default": true,
      "visible_if": {
        "variant": "carousel"
      }
    },
    {
      "key": "interval",
      "type": "range",
      "label": "Time per slide",
      "default": 5,
      "min": 2,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "visible_if": {
        "variant": "carousel"
      }
    },
    {
      "key": "mobile_cols",
      "type": "select",
      "label": "Products per row on phones",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "control": "segmented"
    },
    {
      "key": "show_rating",
      "type": "toggle",
      "label": "Show star rating",
      "default": true
    },
    {
      "key": "show_quick_add",
      "type": "toggle",
      "label": "Show Add to cart button",
      "default": true
    },
    {
      "key": "show_brand",
      "type": "toggle",
      "label": "Show the brand",
      "default": true,
      "advanced": true
    },
    {
      "key": "head_align",
      "type": "select",
      "label": "Heading alignment",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "control": "segmented",
      "advanced": true
    },
    {
      "key": "scheme",
      "type": "color-scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "key": "bg_image",
      "type": "image",
      "label": "Background photo",
      "default": "",
      "advanced": true
    },
    {
      "key": "bg_overlay",
      "type": "range",
      "label": "Darken background photo",
      "default": 40,
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "advanced": true
    },
    {
      "key": "texture",
      "type": "select",
      "label": "Background texture",
      "default": "none",
      "advanced": true,
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "grid",
          "label": "Grid lines"
        },
        {
          "value": "lines",
          "label": "Diagonal lines"
        },
        {
          "value": "grain",
          "label": "Fine grain"
        }
      ]
    },
    {
      "key": "pad",
      "type": "select",
      "label": "Space above and below",
      "default": "md",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "control": "segmented"
    }
  ],
  "presets": [
    {
      "key": "grid",
      "label": "Grid of best sellers",
      "settings": {
        "variant": "grid",
        "source": "best-sellers",
        "heading": "Best sellers",
        "count": 8,
        "cols": 4,
        "rows": 2
      }
    },
    {
      "key": "carousel",
      "label": "Swipe row of new products",
      "settings": {
        "variant": "carousel",
        "source": "newest",
        "heading": "New this season",
        "count": 10,
        "cols": 4
      }
    },
    {
      "key": "on-sale",
      "label": "On sale now",
      "settings": {
        "variant": "grid",
        "source": "on-sale",
        "heading": "On sale now",
        "link_label": "",
        "count": 4,
        "cols": 4,
        "rows": 1
      }
    },
    {
      "key": "list",
      "label": "Compact list",
      "settings": {
        "variant": "list",
        "source": "newest",
        "heading": "Just added",
        "count": 8
      }
    }
  ]
}
