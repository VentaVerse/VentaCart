            }
          },
          {
            "key": "text_y",
            "type": "select",
            "label": "Text position up and down",
            "default": "center",
            "control": "segmented",
            "options": [
              {
                "value": "top",
                "label": "Top"
              },
              {
                "value": "center",
                "label": "Middle"
              },
              {
                "value": "bottom",
                "label": "Bottom"
