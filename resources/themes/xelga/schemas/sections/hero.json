  "variants": [
    {
      "value": "full-image",
      "label": "Full-width photo"
    },
    {
      "value": "split",
      "label": "Photo and text side by side"
    },
    {
      "value": "slideshow",
      "label": "Slideshow"
    },
    {
      "value": "collage",
      "label": "Collage"
    }
  ],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "info": "Collage uses the photos of the first three slides.",
      "default": "full-image",
      "control": "cards",
      "options": [
        {
          "value": "full-image",
          "label": "Full-width photo"
        },
        {
          "value": "split",
          "label": "Photo and text side by side"
        },
        {
          "value": "slideshow",
          "label": "Slideshow"
        },
        {
          "value": "collage",
          "label": "Collage"
        }
      ]
    },
    {
      "key": "height",
      "type": "select",
      "label": "Banner height",
      "default": "medium",
      "control": "segmented",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ]
    },
    {
      "key": "autoplay",
      "type": "toggle",
      "label": "Autoplay",
      "default": true,
      "visible_if": {
        "variant": "slideshow"
      }
    },
    {
      "key": "interval",
      "type": "range",
      "label": "Time per slide",
      "default": 6,
      "min": 2,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "visible_if": {
        "variant": "slideshow"
      }
    },
    {
      "key": "slide_change",
      "type": "select",
      "label": "Transition",
      "default": "fade",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "slide-up",
          "label": "Slide up"
        },
        {
          "value": "zoom",
          "label": "Zoom"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "slow-zoom",
          "label": "Slow zoom"
        }
      ],
      "visible_if": {
        "variant": "slideshow"
      }
