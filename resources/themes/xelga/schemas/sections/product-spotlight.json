{
  "type": "product-spotlight",
  "label": "Product spotlight",
  "group": "template",
  "templates": [
    "*"
  ],
  "limit": null,
  "main": false,
  "class": "s-spotlight",
  "variants": [
    {
      "value": "split",
      "label": "Photo and details"
    },
    {
      "value": "banner",
      "label": "Photo background"
    },
    {
      "value": "compact",
      "label": "Thin strip"
    }
  ],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "Photo and details"
        },
        {
          "value": "banner",
          "label": "Photo background"
        },
        {
          "value": "compact",
          "label": "Thin strip"
        }
      ],
      "control": "cards"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Deal of the week"
    },
    {
      "key": "text",
      "type": "textarea",
      "label": "Text under the heading",
      "default": ""
    },
    {
      "key": "product",
      "type": "product-picker",
      "label": "Product",
      "default": null,
      "info": "Hidden from shoppers who cannot see this product."
    },
    {
      "key": "image",
      "type": "image",
      "label": "Custom photo",
      "default": "",
      "advanced": true
    },
    {
      "key": "focal",
      "type": "select",
      "label": "Keep when cropped, across",
      "default": "center",
      "control": "segmented",
      "advanced": true,
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ]
    },
    {
      "key": "focal_y",
      "type": "select",
      "label": "Keep when cropped, up and down",
      "default": "center",
      "control": "segmented",
      "advanced": true,
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "key": "image_pos",
      "type": "select",
      "label": "Photo side",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "control": "segmented"
    },
    {
      "key": "show_countdown",
      "type": "toggle",
      "label": "Show a countdown to the end of the sale",
      "default": true,
      "info": "Counts down to the end date of the product's special in VentaCart. Hidden when there is none or it is over a year away."
    },
    {
      "key": "show_specs",
      "type": "toggle",
      "label": "Show key specs",
      "info": "Key specs are the attributes marked to show on product cards in VentaCart.",
      "default": true
    },
    {
      "key": "button_label",
      "type": "text",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "key": "scheme",
      "type": "color-scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "key": "bg_image",
      "type": "image",
      "label": "Background photo",
      "default": "",
      "advanced": true
    },
    {
      "key": "bg_overlay",
      "type": "range",
      "label": "Darken background photo",
      "default": 40,
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "advanced": true
    },
    {
      "key": "texture",
      "type": "select",
      "label": "Background texture",
      "default": "none",
      "advanced": true,
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "grid",
          "label": "Grid lines"
        },
        {
          "value": "lines",
          "label": "Diagonal lines"
        },
        {
          "value": "grain",
          "label": "Fine grain"
        }
      ]
    },
    {
      "key": "pad",
      "type": "select",
      "label": "Space above and below",
      "default": "md",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "control": "segmented"
    }
  ],
  "render_keys": [
    "product"
  ],
  "presets": [
    {
      "key": "split",
      "label": "Deal with a countdown",
      "settings": {
        "variant": "split",
        "heading": "Deal of the week",
        "show_countdown": true
      }
    },
    {
      "key": "banner",
      "label": "Wide photo banner",
      "settings": {
        "variant": "banner",
        "heading": "Made for the rainy season",
        "image": "media/xelga/clothes/editorial-workshop.jpg",
        "scheme": "scheme-2"
      }
    },
    {
      "key": "compact",
      "label": "Compact strip",
      "settings": {
        "variant": "compact",
        "heading": "Back in stock",
        "show_specs": false
      }
    }
  ]
}
