{
  "type": "shop-the-look",
  "label": "Shop the look",
  "description": "A photo with dots that show its products.",
  "group": "template",
  "templates": [
    "*"
  ],
  "limit": null,
  "main": false,
  "class": "s-look",
  "variants": [
    {
      "value": "side",
      "label": "Photo with a list beside it"
    },
    {
      "value": "full",
      "label": "Wide photo, list below"
    }
  ],
  "settings": [
    {
      "key": "variant",
      "type": "select",
      "label": "Layout",
      "default": "side",
      "options": [
        {
          "value": "side",
          "label": "Photo with a list beside it"
        },
        {
          "value": "full",
          "label": "Wide photo, list below"
        }
      ],
      "control": "cards"
    },
    {
      "key": "heading",
      "type": "text",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "key": "text",
      "type": "textarea",
      "label": "Text",
      "default": ""
    },
    {
      "key": "image",
      "type": "image",
      "label": "Photo",
      "default": ""
    },
    {
      "key": "image_alt",
      "type": "text",
      "label": "Photo description for screen readers",
      "default": "",
      "advanced": true
    },
    {
      "key": "ratio",
      "type": "select",
      "label": "Photo shape",
      "default": "portrait",
      "control": "segmented",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "tall",
          "label": "Tall"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },
    {
      "key": "image_pos",
      "type": "select",
      "label": "Photo side",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "control": "segmented",
      "visible_if": {
        "variant": "side"
      }
    },
    {
      "key": "show_numbers",
      "type": "toggle",
      "label": "Number the dots and the list",
      "default": true
    },
    {
      "key": "scheme",
      "type": "color-scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "key": "bg_image",
      "type": "image",
      "label": "Background photo",
      "default": "",
      "advanced": true
    },
    {
      "key": "bg_overlay",
      "type": "range",
      "label": "Darken background photo",
      "default": 40,
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "advanced": true
    },
    {
      "key": "texture",
      "type": "select",
      "label": "Background texture",
      "default": "none",
      "advanced": true,
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dots",
          "label": "Dots"
        },
        {
          "value": "grid",
          "label": "Grid lines"
        },
        {
          "value": "lines",
          "label": "Diagonal lines"
        },
        {
          "value": "grain",
          "label": "Fine grain"
        }
      ]
    },
    {
      "key": "pad",
      "type": "select",
      "label": "Space above and below",
      "default": "md",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "control": "segmented"
    }
  ],
  "render_keys": [
    "image"
  ],
  "blocks": {
    "min": 1,
    "max": 6,
    "types": [
      {
        "type": "hotspot",
        "label": "Product dot",
        "settings": [
          {
            "key": "product",
            "type": "product-picker",
            "label": "Product",
            "default": null,
            "info": "Hidden from shoppers who cannot see this product."
          },
          {
            "key": "x",
            "type": "range",
            "label": "Dot position across",
            "info": "Or drag the dot on the preview.",
            "default": 50,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%"
          },
          {
            "key": "y",
            "type": "range",
            "label": "Dot position down",
            "default": 50,
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "%"
          }
        ],
        "limit": null
      }
    ]
  },
  "presets": [
